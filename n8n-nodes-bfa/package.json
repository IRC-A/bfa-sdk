{
  "name": "n8n-nodes-bfa",
  "version": "1.1.7",
  "description": "n8n nodes integration for Backend for Agents (BFA) & IRC-A Protocol (Enterprise Edition)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp",
    "prepublishOnly": "npm run build",
    "release": "npm version patch && npm publish --access public"
  },
  "keywords": [
    "n8n-community-node-package",
    "bfa",
    "irc-a",
    "langsmith",
    "agents",
    "mcp"
  ],
  "author": "Sandro G.",
  "license": "Commercial",
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0"
  },
  "dependencies": {
    "langsmith": "^0.1.33",
    "@langchain/core": "^0.2.16",
    "@langchain/openai": "^0.2.5"
  },
  "n8n": {
    "nodes": [
      "dist/nodes/BfaAgent/BfaAgent.node.js",
      "dist/nodes/BfaMcp/BfaMcp.node.js",
      "dist/nodes/IrcaGateway/IrcaGateway.node.js",
      "dist/nodes/BfaEntryPointAgent/BfaEntryPointAgent.node.js"
    ],
    "credentials": [
      "dist/credentials/BfaAgentCredentials.credentials.js"
    ]
  }
}
